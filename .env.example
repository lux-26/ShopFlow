# Configuration backend ShopFlow
# Copiez ce fichier vers .env à la racine du dépôt pour les scripts lancés depuis la racine.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shopflow
JWT_SECRET=remplacez-par-une-cle-aleatoire-longue-et-unique
CLIENT_URL=http://localhost:5173

# Cloudinary (nécessaire pour l'hébergement des images produits)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email transactionnel (facultatif en développement)
RESEND_API_KEY=
EMAIL_FROM=

# Création facultative du premier compte administrateur
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
