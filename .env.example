# Serveur
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB : adaptez l'URL à votre instance locale ou MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/shopflow

# Remplacez cette valeur par une chaîne longue, unique et secrète.
JWT_SECRET=remplacez-par-une-cle-secrete-longue-et-aleatoire

# Compte administrateur initial (utilisé uniquement par npm run seed:admin).
ADMIN_NAME=Administrateur ShopFlow
ADMIN_EMAIL=admin@shopflow.local
ADMIN_PASSWORD=remplacez-par-un-mot-de-passe-solide
